		header_up Host {host}
	}

	reverse_proxy citizen-pwa:3000

	# WAF-lite security headers at the edge (deep WAF lives in APISIX/OpenAppSec).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://sos.nasarawastate.gov.ng"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		format json
	}
}


