# GENERATED by deploy/caddy/generate_caddyfile.py -- do not edit by hand.

{
	# Admin API bound to localhost only (orchestrator may disable entirely).
	admin localhost:2019
	# Prometheus metrics: scrape :2019/metrics (servers metrics enabled).
	servers {
		metrics
	}
	# On-demand TLS gate. Caddy asks this GET endpoint before issuing a
	# cert for any host in the fallback block. The control-plane verify
	# endpoint is POST (/cp/v1/domains/verify), so a shim sidecar serves
	# GET /cp/v1/domains/allowed?domain={domain} backed by the regenerated
	# allowed_domains.json file (see docs/architecture/edge-caddy.md).
	on_demand_tls {
		ask http://control-plane:8000/cp/v1/domains/allowed
		interval 2m
		burst 5
	}
	email sre@unified-sos.gov.ng
}

# --- abia ---
sos.abiastate.gov.ng {
	# Serve the citizen PWA (static frontend) for everything that is not API.
	encode zstd gzip

	@api path /api/*
	reverse_proxy @api apisix:9080 {
		# Preserve the tenant Host header so APISIX routes per-state.
		header_up Host {host}
	}

	reverse_proxy citizen-pwa:3000

	# WAF-lite security headers at the edge (deep WAF lives in APISIX/OpenAppSec).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://sos.abiastate.gov.ng"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		format json
	}
}


