# deploy/tuning/my.cnf
# MySQL 8.0 (InnoDB) tuning for the Mojaloop central-ledger database.
# Scope: Mojaloop's internal ledger/settlement store ONLY. TigerBeetle remains
# the platform's system-of-record ledger (Layer 2, >1M TPS design target).
# See docs/operations/performance-tuning.md#mojaloop-database for the
# supported-database decision record (MySQL is the upstream-supported engine;
# Postgres dialect forks are experimental).

[mysqld]
# --- InnoDB buffer pool -----------------------------------------------------
# Central-ledger is small but hot: transfers, positions, settlement windows.
# Size to 60-70% of a dedicated DB node (16 vCPU / 64 GiB assumed).
innodb_buffer_pool_size = 40G
innodb_buffer_pool_instances = 8
innodb_buffer_pool_dump_at_shutdown = ON
innodb_buffer_pool_load_at_startup = ON
innodb_change_buffering = none           # OLTP with unique index writes; no benefit

# --- Redo log ---------------------------------------------------------------
innodb_redo_log_capacity = 8G            # MySQL 8.0.30+; absorbs settlement bursts
innodb_flush_log_at_trx_commit = 1       # ACID for settlement; use 2 only on replicas
sync_binlog = 1
innodb_flush_method = O_DIRECT
innodb_io_capacity = 4000                # NVMe
innodb_io_capacity_max = 8000
innodb_write_io_threads = 8
innodb_read_io_threads = 8

# --- Binlog / replication -----------------------------------------------------
binlog_format = ROW                      # required by Mojaloop CDC & audit replay
binlog_row_image = MINIMAL               # smaller row events, less I/O
binlog_expire_logs_seconds = 604800      # 7 days; DR runbook replays via snapshot+binlog
gtid_mode = ON
enforce_gtid_consistency = ON
# Group commit: batch fsyncs under settlement-window bursts
binlog_group_commit_sync_delay = 2000    # microseconds; ~2ms amortizes fsync
binlog_group_commit_sync_no_delay_count = 100

# --- Connections -------------------------------------------------------------
# Mojaloop central-ledger/central-settlement services pool via knex; cap to
# protect InnoDB thread concurrency under fan-in from quoting/transfer APIs.
max_connections = 800
max_connect_errors = 1000000
innodb_thread_concurrency = 32
thread_pool_size = 16                    # if Percona thread pool is available
wait_timeout = 600
interactive_timeout = 600

# --- Transaction / locking ----------------------------------------------------
transaction_isolation = READ-COMMITTED   # Mojaloop default; fewer gap locks than RR
innodb_lock_wait_timeout = 20
innodb_deadlock_detect = ON
innodb_print_all_deadlocks = ON

# --- Misc ----------------------------------------------------------------------
table_open_cache = 8000
table_definition_cache = 4000
tmp_table_size = 256M
max_heap_table_size = 256M
performance_schema = ON
slow_query_log = ON
long_query_time = 0.5
log_queries_not_using_indexes = OFF      # knex ORM noise; enable ad hoc for audits

[client]
default-character-set = utf8mb4
