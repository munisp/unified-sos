{
  "realm": "sos-dev",
  "enabled": true,
  "displayName": "SOS Local Development",
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "sos-admin", "description": "Platform administrator (dev)" },
      { "name": "sos-revenue-officer", "description": "State IRS revenue officer (dev)" },
      { "name": "sos-auditor-readonly", "description": "Auditor-General read-only access (dev)" }
    ]
  },
  "clients": [
    {
      "clientId": "sos-services",
      "description": "Service-to-service client for SOS modules (dev)",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "sos-services-dev-only-not-a-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "dev-officer",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "dev-only-not-a-secret", "temporary": false }
      ],
      "realmRoles": ["sos-revenue-officer"]
    }
  ]
}
