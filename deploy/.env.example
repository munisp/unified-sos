# SOS local development defaults — OBVIOUSLY FAKE, dev-only values.
# Copy to .env (`cp deploy/.env.example deploy/.env`). Never use in production;
# production secrets are issued per-state via OpenBao (see infra/helm).

POSTGRES_USER=sos
POSTGRES_PASSWORD=sos-dev-only-not-a-secret
POSTGRES_DB=sos

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only-not-a-secret

MINIO_ROOT_USER=sos-dev
MINIO_ROOT_PASSWORD=sos-dev-only-not-a-secret

OPENSEARCH_ADMIN_PASSWORD=SosDevOnly_NotASecret1!

# One of: lagos | ogun | osun | benue | nasarawa | taraba
TENANT_STATE_ID=osun
